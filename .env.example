# AgriVision AI - Environment Configuration
# Copy this file to .env.local for local development, or add these variables to your Vercel Project Settings.

# -------------------------------------------------------------
# 1. Vercel Blob Storage
# Automatically injected when you create a Blob Store in Vercel Dashboard -> Storage -> Blob.
# For local dev, obtain this token from: vercel.com/<team>/agrivision-ai/stores/blob/<store-id>
# -------------------------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# -------------------------------------------------------------
# 2. Supabase Persistence
# Obtain these from: supabase.com/dashboard/project/<project-id>/settings/api
# -------------------------------------------------------------
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." # Recommended for serverless routes
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# -------------------------------------------------------------
# 3. Training & Admin Security Token
# Protects retraining triggers and candidate deployments from unauthorized execution.
# -------------------------------------------------------------
TRAINING_SECRET_KEY="agrivision_secret_admin_token_change_in_production"
